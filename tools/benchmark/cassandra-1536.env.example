# 本机后续压测候选参数；不是生产配置，不会自动启动或切换数据库。
# API、worker 及 Rust 数据服务必须统一使用 Cassandra，并重建对应镜像。
FLUXER_DATABASE_BACKEND=cassandra
FLUXER_CASSANDRA_HOSTS=127.0.0.1
FLUXER_CASSANDRA_PORT=29042
FLUXER_CASSANDRA_KEYSPACE=fluxer_benchmark
FLUXER_CASSANDRA_LOCAL_DC=datacenter1
FLUXER_CHANNEL_METADATA_CACHE_ENABLED=true
FLUXER_GUILD_AVAILABILITY_CACHE_ENABLED=true

# MAX_HEAP_SIZE 仅供支持此环境变量的 Cassandra 启动器使用。
# 直接启动 JVM 时须显式设置 -Xms1536M -Xmx1536M，并核对实际生效参数。
MAX_HEAP_SIZE=1536M

# Docker 内部连接需改为测试 Cassandra 服务名和内部端口，不能照搬宿主机地址。
# 堆不等于总内存；保留现有整体资源保护，不能把数据库容器限制为 1536MiB。
# 持久性沿用 commitlog_sync=batch；不得为提高成绩改成周期确认。
